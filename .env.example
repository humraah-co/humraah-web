# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Never commit .env.local. Ask Musab for the dev values via a Bitwarden Send link.

# Browser-safe (prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — never prefix with NEXT_PUBLIC_. Needed from Day 4 (team invites).
SUPABASE_SERVICE_ROLE_KEY=
