# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Never commit .env.local. Ask Musab for the dev values via a Bitwarden Send link.

# Browser-safe (prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The Urdu site at /ur. Keep false until the Urdu has been reviewed; set to
# true (locally, and on Vercel for each environment) to switch it on.
NEXT_PUBLIC_URDU_ENABLED=false

# Server only — never prefix with NEXT_PUBLIC_. Needed from Day 4 (team invites).
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string (for example `openssl rand -hex 32`). It keys the hash
# of each visitor's IP address for the contact form's rate limit; no address is
# ever stored. Without it the rate limit is switched off.
CONTACT_IP_HASH_SECRET=
