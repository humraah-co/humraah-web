{
  "name": "humraah-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "node scripts/build-ci.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "node supabase/tests/access-rules.test.mjs && node supabase/tests/content-editors.test.mjs && node supabase/tests/messages.test.mjs && node supabase/tests/rerun-migrations.test.mjs",
    "test:i18n": "node --test \"src/i18n/*.test.ts\"",
    "test:theme": "node --test \"src/lib/theme/*.test.ts\"",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "urdu:export": "node scripts/urdu-review.mjs export",
    "urdu:apply": "node scripts/urdu-review.mjs apply"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.59.0",
    "next": "15.5.28",
    "next-intl": "^4.14.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.31"
    }
  }
}
